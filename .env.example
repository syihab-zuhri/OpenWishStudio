# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose to the browser, server-side only
# Get from: Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Used by Supabase CLI for db:generate-types, db:migrate
SUPABASE_PROJECT_ID=your-project-ref

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional: OAuth (if enabling Google login) ────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
